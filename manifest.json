{
  "manifest_version": 3,
  "name": "Preface Scheduler",
  "version": "0.1.2",
  "description": "Force-shows hidden task labels on nomad.preface.ai. Toggle and drag from the in-page widget.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://nomad.preface.ai/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://nomad.preface.ai/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
